#!/usr/bin/env bash
set -euo pipefail

pid_file="${TMPDIR:-/tmp}/toggle-process.pid"
lock_file="${TMPDIR:-/tmp}/toggle-process.lock"
signal="TERM"
usage() {
  cat <<EOF
Usage:
  $0 [OPTIONS] -- <COMMAND> [ARGS]...

Arguments:
  <COMMAND>  Command to run
  [ARGS]...  Arguments for the Command

Options:
  --pid-file <PATH>   PID file (default: \${TMPDIR:-/tmp}/toggle-process.pid)
  --lock-file <PATH>  Lock file (default: \${TMPDIR:-/tmp}/toggle-process.lock)
  -s SIGNAL           Signal to send (default: TERM)
  -h, --help          Show this help message
EOF
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pid-file=*)  pid_file="${1#*=}"; shift ;;
    --pid-file)    pid_file="${2:?}"; shift 2 ;;
    --lock-file=*) lock_file="${1#*=}"; shift ;;
    --lock-file)   lock_file="${2:?}"; shift 2 ;;
    -s)            signal="${2:?}"; shift 2 ;;
    -h|--help)     usage ;;
    --)            shift; break ;;
    *)             shift ;;
  esac
done

if [[ $# -eq 0 ]]; then
  usage 1
fi

exec 9>"$lock_file"

if flock -n 9; then
  (
    "$@" &
    pid=$!
    echo "$pid" >"$pid_file"
    wait "$pid"
    rm -f "$pid_file"
  ) &
else
  if [[ -r $pid_file ]]; then
    pid=$(<"$pid_file")
    if kill -0 "$pid" 2>/dev/null; then
      kill "-$signal" "$pid"
    fi
  fi
fi

